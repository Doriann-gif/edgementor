# EdgeMentor client environment variables.
# Copy to .env for local dev, and set the same keys in the Netlify dashboard
# for production. These are the PUBLIC (publishable/anon) Supabase values —
# they are embedded in the client bundle and protected by Row Level Security.
# NEVER put the service_role key or any other secret in a VITE_ variable.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
